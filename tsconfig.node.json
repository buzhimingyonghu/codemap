{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/map/geo.ts",
    "src/renderer/src/map/model.ts",
    "src/renderer/src/map/d3-voronoi-map.d.ts",
    "src/renderer/src/codemap/model.ts",
    "src/renderer/src/codemap/layout.ts",
    "tests/unit/**/*",
    "vitest.config.ts"
  ]
}
