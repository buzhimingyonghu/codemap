{
  "name": "codemap-ide",
  "productName": "Codemap",
  "version": "0.1.0",
  "description": "A small, focused macOS code editor with files, build output, Git, debugging, and local plugins.",
  "main": "./out/main/index.js",
  "author": "Victor Liu",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/fix-node-pty.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:agent": "node tests/e2e/agent.mjs",
    "test:e2e:app": "node tests/e2e/smoke.mjs --app release/mac-arm64/Codemap.app",
    "check": "npm run typecheck && npm test",
    "codemap:validate": "node scripts/codemap-validate.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --mac --arm64",
    "package:dir": "npm run build && electron-builder --mac dir --arm64",
    "clean": "rm -rf out release *.tsbuildinfo tests/e2e/artifacts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "d3-voronoi-map": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.51.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
